{
  "name": "@platform-mesh/portal-ui-lib",
  "version": "0.68.0",
  "repository": {
    "url": "git+https://github.com/platform-mesh/portal-ui-lib.git"
  },
  "author": "Platform Mesh",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ng": "ng",
    "build": "npm run build:lib && npm run build:wc",
    "build:dev": "npm run build:lib && npm run build:wc:dev",
    "build:lib": "ng build lib",
    "build:wc": "ng build wc && npm run build:wc:bundle && npm run build:wc:copy",
    "build:wc:bundle": "node scripts/bundle-wc.mjs",
    "build:wc:copy": "cpx \"dist-wc/**/*\" dist",
    "build:wc:dev": "ng build wc --configuration development && npm run build:wc:bundle && npm run build:wc:copy",
    "build:watch": "mkdirp dist && nodemon",
    "watch": "npm run build --watch --configuration development",
    "test": "ng test --watch=false && npm run test:integration",
    "test:lib": "ng test lib --watch=false",
    "test:wc": "ng test wc --watch=false",
    "test:integration": "playwright install --with-deps --only-shell chromium && npm run build:wc && playwright test --config integration/playwright.config.ts",
    "test:integration:v": "PLAYWRIGHT_VIDEO=on npm run test:integration",
    "test:integration:ui": "playwright test --config integration/playwright.config.ts --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "prettier": "@openmfp/config-prettier",
  "dependencies": {
    "jsonpath-plus": "10.4.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@angular-eslint/builder": "22.1.0",
    "@angular/animations": "22.2.1",
    "@angular/build": "22.2.1",
    "@angular/cdk": "22.1.2",
    "@angular/cli": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/elements": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/localize": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@angular/router": "22.2.1",
    "@fundamental-ngx/ui5-webcomponents": "0.64.1",
    "@fundamental-ngx/ui5-webcomponents-fiori": "0.64.1",
    "@luigi-project/client": "2.32.0",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/ngx": "1.12.0",
    "@openmfp/portal-ui-lib": "0.198.8",
    "@playwright/test": "1.63.0",
    "@storybook/angular": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.3",
    "cpx2": "9.0.0",
    "esbuild": "0.28.2",
    "flatted": "3.4.3",
    "immutable": "5.1.9",
    "jsdom": "30.0.1",
    "kubernetes-types": "1.30.0",
    "mkdirp": "3.0.1",
    "ng-packagr": "22.1.1",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "storybook": "^10.6.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vitest-mock-extended": "5.1.1"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "http-proxy-middleware": "4.2.0",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "uuid": "14.0.1",
    "vite": "8.3.3",
    "zod": "4.6.6",
    "@modelcontextprotocol/server": "2.3.0",
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "7.4.6"
    }
  }
}
